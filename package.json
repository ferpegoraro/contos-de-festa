{
  "name": "contos-de-festas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:back\"",
    "dev:front": "next dev --port 3000",
    "dev:back": "tsx watch api/src/server.ts",
    "build": "next build",
    "start": "next start",
    "start:back": "tsx api/src/server.ts",
    "lint": "eslint",
    "prisma": "prisma --schema=api/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=api/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=api/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=api/prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:stop": "docker compose stop",
    "test": "vitest run --config api/vitest.config.ts",
    "test:watch": "vitest --config api/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config api/vitest.config.ts",
    "test:integration": "vitest run --config api/vitest.integration.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "prisma": "^6.19.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.22.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
